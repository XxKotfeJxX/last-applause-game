{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["vite/client", "vitest/globals"]
